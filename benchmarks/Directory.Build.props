<Project>
    <!-- Import the repo-root props, then narrow multi-targeting to net10.0 for benchmark projects. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <PropertyGroup>
        <!-- Benchmark exes (and BenchmarkDotNet's auto-generated bootstrap project, which nests under
             a benchmark's bin folder and inherits these props) must target a single framework. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
        <!-- The auto-generated bootstrap project sets its own singular TargetFramework to match the
             host benchmark exe. Clear the plural so it wins, letting a benchmark override the default
             (e.g. <TargetFrameworks>net11.0</TargetFrameworks> in its csproj). -->
        <TargetFrameworks Condition="'$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated'"></TargetFrameworks>
    </PropertyGroup>
</Project>
